APP_ENV='development'
APP_PORT=3000

DB_HOST=localhost # postgres
DB_PORT=5439 # 5432
DB_USER=dev-psql-user
DB_PASSWORD=dev-password
DB_NAME=dev-db-name

# required in production; generate e.g. with `openssl rand -base64 48`
JWT_ACCESS_SECRET='your_jwt_access_secret'
JWT_REFRESH_SECRET='your_jwt_refresh_secret'
# seconds or a number with s / m / h / d
JWT_ACCESS_TTL='15m'
JWT_REFRESH_TTL='7d'
PASSWORD_RESET_TTL='1d'

FEATURE_REGISTER='FALSE'

INIT_EMAIL='test@gmail.com'
INIT_PASSWORD='qwerty123'
