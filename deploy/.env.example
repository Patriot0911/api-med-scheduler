# copy to /app/med-scheduler/api/.env on the server, chmod 600
# APP_ENV, APP_PORT, in-container DB_HOST / DB_PORT and DB_MIGRATIONS_RUN are fixed in docker-compose.yml

# host ports, bound to 127.0.0.1
API_PORT=3000
DB_PORT=5432

# image tag: latest by default, sha-<short> to pin or roll back
# API_TAG=latest

DB_USER=med_app
DB_PASSWORD=change-me
DB_NAME=med_scheduler

CORS_ORIGINS=https://medscheduler.com

# openssl rand -base64 48, different values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL=1d

FEATURE_REGISTER=FALSE

# only for the one-time seed, remove afterwards
# INIT_EMAIL=
# INIT_PASSWORD=
