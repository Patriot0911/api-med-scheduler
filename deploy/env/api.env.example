# APP_ENV, APP_PORT, DB_HOST, DB_PORT, DB_MIGRATIONS_RUN are fixed in compose.api.yml
# DB_* must match env/postgres.env
DB_USER=med_app
DB_PASSWORD=change-me
DB_NAME=med_scheduler

CORS_ORIGINS=https://medscheduler.com

# openssl rand -base64 48, different values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL=1d

FEATURE_REGISTER=FALSE

# only for the one-time seed, remove afterwards
# INIT_EMAIL=
# INIT_PASSWORD=
