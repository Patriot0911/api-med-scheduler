{
	email {$ACME_EMAIL}
	admin localhost:2019
}

# (api_upstream) and (web_upstream) point at the live colour of each service; deploy.sh rewrites these files
import /etc/caddy/active/*.caddy

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$WEB_ADDRESS} {
	import common
	import web_upstream
}

{$API_ADDRESS} {
	import common
	handle /api/docs* {
		respond 404
	}
	handle {
		import api_upstream
	}
}
